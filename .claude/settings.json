{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command",
        "command": "python3 .claude/hooks/graph_index.py || python .claude/hooks/graph_index.py",
        "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command",
        "command": "python3 .claude/hooks/graph_index.py --quiet || python .claude/hooks/graph_index.py --quiet",
        "timeout": 10 } ] }
    ]
  }
}